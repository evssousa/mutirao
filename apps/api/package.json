{
  "name": "@mutirao/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/servidor.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/servidor.js",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@mutirao/shared": "*",
    "@prisma/client": "^5.20.0",
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "dotenv-cli": "^7.4.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
