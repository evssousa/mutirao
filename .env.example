# Copie para .env e preencha. Nunca commitar o .env (repositório é público).
# Passo a passo de onde conseguir cada valor: docs/ambiente-de-desenvolvimento.md

# --- Banco (Neon) ---
# Conexão via pooler — obrigatória em ambiente serverless (plan.md, secao 12.1)
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/mutirao?sslmode=require"
# Conexão direta — usada só pelas migrations, o pooler não suporta DDL
DIRECT_URL="postgresql://usuario:senha@host.neon.tech/mutirao?sslmode=require"

# --- GitHub OAuth (plan.md, secao 9.4) ---
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Webhook do GitHub (plan.md, secao 9.2) ---
GITHUB_WEBHOOK_SECRET=""

# --- Sessão ---
SESSION_SECRET=""

# --- Motor de decomposição por IA (plan.md, secao 7) ---
IA_PROVEDOR=""
IA_API_KEY=""

# --- App ---
PORTA_API=3333
URL_WEB="http://localhost:5173"
# Base usada para montar a callback URL do OAuth (URL_API + "/api/auth/callback/github").
# Só precisa preencher fora de localhost puro.
#
# Rodando num GitHub Codespace: use a URL encaminhada do FRONT (porta 5173),
# não a da API. O navegador nunca fala direto com a porta da API — só via
# proxy do Vite (apps/web/vite.config.ts) — porque falar direto com uma
# porta privada do Codespaces injeta uma tela de login própria do GitHub no
# meio do redirect OAuth, que derruba o cookie de state (docs/ambiente-de-
# desenvolvimento.md, seção 11).
# URL_API="https://<nome-do-codespace>-5173.app.github.dev"
# Nesse caso o "Redirect URI" do OAuth App também precisa apontar pra essa
# mesma URL + "/api/auth/callback/github".
URL_API=""
